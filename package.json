{
  "name": "ustozlar-jamoasi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @edu/api dev",
    "dev:web": "pnpm --filter @edu/web dev",
    "db:migrate": "pnpm --filter @edu/db migrate",
    "db:generate": "pnpm --filter @edu/db generate",
    "db:seed": "pnpm --filter @edu/db seed",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @edu/db generate && pnpm --filter @edu/web build"
  }
}
