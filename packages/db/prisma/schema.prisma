// Onlayn ta'lim platformasi: ma'lumotlar bazasi sxemasi (TZ, 6-bo'lim).
// Sayt, bot va admin panel shu bitta bazadan foydalanadi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // ustoz: login va parol bilan kiradi
  STUDENT // talaba: Telegram orqali kiradi
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id               String     @id @default(cuid())
  role             Role       @default(STUDENT)
  status           UserStatus @default(ACTIVE)
  // Talaba: Telegram orqali aniqlanadi
  telegramId       BigInt?    @unique
  telegramUsername String?
  // Admin: login va parol (scrypt xesh)
  login            String?    @unique
  passwordHash     String?
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?

  firstName        String     @default("")
  lastName         String     @default("")
  phone            String?    @unique
  region           String? // viloyat
  district         String? // tuman
  address          String?
  institution      String? // ta'lim muassasasi
  grade            String? // sinf yoki kurs
  // Anketa to'ldirilmaguncha talabaga boshqa bo'limlar ochilmaydi
  profileCompleted Boolean    @default(false)
  lastActiveAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  courseAccess   CourseAccess[] @relation("AccessUser")
  grantedAccess  CourseAccess[] @relation("AccessGrantedBy")
  progress       LessonProgress[]
  attempts       Attempt[]
  certificates   Certificate[]
  auditLogs      AuditLog[]

  @@index([role, createdAt])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  courses Course[]
  tests   Test[]
}

model Course {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  title       String
  description String?
  coverFileId String?
  isPaid      Boolean  @default(true)
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]
  access  CourseAccess[]
  tests   Test[]
}

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  // YouTube, Vimeo, Bunny Stream havolasi yoki yuklangan MP4
  videoUrl    String?
  // Konspekt: Markdown + LaTeX formulalar
  content     String?
  durationSec Int?
  // Pullik kurs ichidagi bepul tanishtiruv darsi
  isPreview   Boolean  @default(false)
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  files    LessonFile[]
  progress LessonProgress[]
}

model LessonFile {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String
  fileId   String
  file     File   @relation(fields: [fileId], references: [id])
  order    Int    @default(0)
}

// Pullik kursga ruxsatni admin beradi; expiresAt bo'sh bo'lsa muddatsiz
model CourseAccess {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("AccessUser", fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedById String?
  grantedBy   User?     @relation("AccessGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
}

model Test {
  id               String    @id @default(cuid())
  subjectId        String
  subject          Subject   @relation(fields: [subjectId], references: [id])
  // Kursga bog'langan test faqat shu kursga ruxsati borlarga ochiq
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id])
  title            String
  description      String?
  durationMin      Int       @default(60)
  questionCount    Int       @default(20)
  shuffleQuestions Boolean   @default(true)
  shuffleOptions   Boolean   @default(true)
  maxAttempts      Int? // null = cheksiz
  opensAt          DateTime?
  closesAt         DateTime?
  requiresCode     Boolean   @default(false)
  password         String?
  showAnswers      Boolean   @default(true)
  isActive         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questions   Question[]
  attempts    Attempt[]
  accessCodes AccessCode[]
}

model Question {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  text        String // Markdown + LaTeX
  imageUrl    String?
  explanation String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  // Statistika (qayta hisoblanadi)
  pCorrect    Float?
  raschB      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options Option[]
  answers AttemptAnswer[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  imageUrl   String?
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  answers AttemptAnswer[]
}

model AccessCode {
  id        String    @id @default(cuid())
  testId    String
  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  code      String    @unique
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  attempts Attempt[]
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
  EXPIRED
}

model Attempt {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  testId       String
  test         Test          @relation(fields: [testId], references: [id])
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  deadlineAt   DateTime
  finishedAt   DateTime?
  // Shu urinishdagi savollar va variantlar tartibi: [{q, o:[...]}]
  layout       Json
  correctCount Int?
  totalCount   Int?
  scorePct     Float?
  accessCodeId String?
  accessCode   AccessCode?   @relation(fields: [accessCodeId], references: [id])

  answers     AttemptAnswer[]
  certificate Certificate?

  @@index([testId, status, scorePct])
  @@index([userId])
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  optionId   String?
  option     Option?  @relation(fields: [optionId], references: [id])
  flagged    Boolean  @default(false)
  isCorrect  Boolean?
  updatedAt  DateTime @updatedAt

  @@unique([attemptId, questionId])
}

model Certificate {
  id        String   @id @default(cuid())
  number    String   @unique // ochiq tekshirish ID: ATT-2026-XXXXXXXX
  attemptId String   @unique
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  issuedAt  DateTime @default(now())
}

model CertificateTemplate {
  id               String   @id @default(cuid())
  title            String   @default("SERTIFIKAT")
  organization     String?
  signerName       String?
  backgroundFileId String?
  minScorePct      Float    @default(60)
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model Channel {
  id        String  @id @default(cuid())
  chatId    String  @unique // @kanal yoki -100...
  title     String
  inviteUrl String
  isActive  Boolean @default(true)
  order     Int     @default(0)
}

model Setting {
  key   String @id // contacts, about, site
  value Json
}

enum FileKind {
  IMAGE // savol rasmlari, muqovalar: ochiq
  MATERIAL // dars fayllari: kursga ruxsati borlarga
  PRIVATE // faqat admin
}

// Fayllar bazada saqlanadi: Render diski har deployda tozalanadi
model File {
  id           String   @id @default(cuid())
  kind         FileKind
  name         String
  mime         String
  size         Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  lessonFiles LessonFile[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
